{"\u27e6CODE1\u27e7": "[\"```python\", \"from datetime import datetime\", \"\", \"from devtools import debug\", \"\", \"from pydantic import BaseModel\", \"\", \"\", \"class Address(BaseModel):\", \"    street: str\", \"    country: str\", \"    lat: float\", \"    lng: float\", \"\", \"\", \"class User(BaseModel):\", \"    id: int\", \"    name: str\", \"    signup_ts: datetime\", \"    friends: list[int]\", \"    address: Address\", \"\", \"\", \"user = User(\", \"    id='123',\", \"    name='John Doe',\", \"    signup_ts='2019-06-01 12:22',\", \"    friends=[1234, 4567, 7890],\", \"    address=dict(street='Testing', country='uk', lat=51.5, lng=0),\", \")\", \"debug(user)\", \"print('\\\\nshould be much easier read than:\\\\n')\", \"print('user:', user)\", \"```\"]", "\u27e6CODE2\u27e7": "[\"<div class=\\\"highlight\\\">\", \"<pre><code><!-- DO NOT EDIT MANUALLY: Generated by tests/test_docs.py::test_docs_devtools_example for use in docs -->\", \"<span class=\\\"ansi35\\\">devtools_example.py</span>:<span class=\\\"ansi32\\\">30</span> <span class=\\\"ansi3 ansi32\\\">&lt;module&gt;</span>\", \"    <span class=\\\"ansi34\\\">user</span>: <span class=\\\"ansi38-252\\\">User</span><span class=\\\"ansi38-252\\\">(</span>\", \"<span class=\\\"ansi38-252\\\">        </span><span class=\\\"ansi38-5\\\">id</span><span class=\\\"ansi38-68\\\">=</span><span class=\\\"ansi38-5\\\">123</span><span class=\\\"ansi38-252\\\">,</span>\", \"<span class=\\\"ansi38-252\\\">        </span><span class=\\\"ansi38-252\\\">name</span><span class=\\\"ansi38-68\\\">=</span><span class=\\\"ansi38-1\\\">'</span><span class=\\\"ansi38-1\\\">John Doe</span><span class=\\\"ansi38-1\\\">'</span><span class=\\\"ansi38-252\\\">,</span>\", \"<span class=\\\"ansi38-252\\\">        </span><span class=\\\"ansi38-252\\\">signup_ts</span><span class=\\\"ansi38-68\\\">=</span><span class=\\\"ansi38-252\\\">datetime</span><span class=\\\"ansi38-68\\\">.</span><span class=\\\"ansi38-252\\\">datetime</span