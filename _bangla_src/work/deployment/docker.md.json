{"\u27e6CODE1\u27e7": "[\"```console\", \"$ uv add \\\"fastapi[standard]\\\" pydantic\", \"---> 100%\", \"```\"]", "\u27e6CODE2\u27e7": "[\"```console\", \"$ uv export --format requirements-txt --no-dev --no-emit-project --output-file requirements.txt\", \"```\"]", "\u27e6CODE3\u27e7": "[\"```Python\", \"from fastapi import FastAPI\", \"\", \"app = FastAPI()\", \"\", \"\", \"@app.get(\\\"/\\\")\", \"def read_root():\", \"    return {\\\"Hello\\\": \\\"World\\\"}\", \"\", \"\", \"@app.get(\\\"/items/{item_id}\\\")\", \"def read_item(item_id: int, q: str | None = None):\", \"    return {\\\"item_id\\\": item_id, \\\"q\\\": q}\", \"```\"]", "\u27e6CODE4\u27e7": "[\"```Dockerfile\", \"# \\u2705 Do this\", \"CMD [\\\"fastapi\\\", \\\"run\\\", \\\"app/main.py\\\", \\\"--port\\\", \\\"80\\\"]\", \"```\"]", "\u27e6CODE5\u27e7": "[\"```Dockerfile\", \"# \\u26d4\\ufe0f Don't do this\", \"CMD fastapi run app/main.py --port 80\", \"```\"]", "\u27e6CODE6\u27e7": "[\"```\", \".\", \"\\u251c\\u2500\\u2500 app\", \"\\u2502\\u00a0\\u00a0 \\u251c\\u2500\\u2500 __init__.py\", \"\\u2502   \\u2514\\u2500\\u2500 main.py\", \"\\u251c\\u2500\\u2500 Dockerfile\", \"\\u2514\\u2500\\u2500 requirements.txt\", \"```\"]", "\u27e6CODE7\u27e7": "[\"```Dockerfile\", \"CMD [\\\"fastapi\\\", \\\"run\\\", \\\"app/main.py\\\", \\\"--proxy-headers\\\", \\\"--port\\\", \\\"80\\\"]\", \"```\"]", "\u27e6CODE8\u27e7": "[\"```Dockerfile\", \"COPY ./requirements.txt /code/requirements.txt\", \"```\"]", "\u27e6CODE9\u27e7": "[\"```Dockerfile\", \"RUN pip install --no-cache-dir --upgrade -r /code/requirements.txt\", \"```\"]", "\u27e6CODE10\u27e7": "[\"```Dockerfile\", \"COPY ./app /code/app\", \"```\"]", "\u27e6CODE11\u27e7": "[\"```console\", \"$ docker build -t myimage .\", \"\", \"---> 100%\", \"```\"]", "\u27e6CODE12\u27e7": "[\"```console\", \"$ docker run -d --name mycontainer -p 80:80 myimage\", \"```\"]", "\u27e6CODE13\u27e7": "[\"```JSON\", \"{\\\"item_id\\\": 5, \\\"q\\\": \\\"somequery\\\"}\", \"```\"]", "\u27e6CODE14\u27e7": "[\"```\", \".\", \"\\u251c\\u2500\\u2500 Dockerfile\", \"\\u251c\\u2500\\u2500 main.py\", \"\\u2514\\u2500\\u2500 requirements.txt\", \"```\"]"}